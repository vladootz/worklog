#!/bin/bash
# ai-worklog launcher: ingest → serve → open browser → re-ingest every 5 min.
# Ctrl-C stops the server and the loop.
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PORT=8111
USAGE="usage: bin/worklog [--skip-digests] [--digest-days N]"

print_help() {
    cat <<EOF
$USAGE

Ingests, serves the dashboard at http://localhost:8111 and opens it in your
browser. Then it ingests again every 5 minutes. If a server already answers on
that port, it uses that server. Ctrl-C stops the loop, and the server if
bin/worklog started it.

  --skip-digests    pass --skip-digests to every ingest (no Ollama digests)
  --digest-days N   pass --digest-days N to every ingest
  -h, --help        print this help, then exit

For a one-time run (--digests-only, --digest-from, --digest-to, --recoalesce,
--zone, --zones), use php ingest.php.
EOF
}

usage_error() { # message [hint]
    echo "$1" >&2
    echo "$USAGE" >&2
    if [ $# -gt 1 ]; then echo "$2" >&2; fi
    exit 2
}

# The arguments go to every ingest pass, so only the options that make sense every
# 5 minutes are accepted. Checked here, before the first ingest.
check_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
        --skip-digests | --digest-days=[!-]*) ;;
        --digest-days)
            case "${2:-}" in '' | -*) usage_error "missing value for --digest-days" ;; esac
            shift
            ;;
        --digest-days=*) usage_error "missing value for --digest-days" ;;
        --digests-only | --digest-from | --digest-from=* | --digest-to | --digest-to=* | --recoalesce | --zone | --zone=* | --zones)
            usage_error "unknown option: $1" "Run one-time ingest options with php ingest.php." ;;
        *) usage_error "unknown option: $1" ;;
        esac
        shift
    done
}
for arg in "$@"; do
    case "$arg" in -h | --help) print_help; exit 0 ;; esac
done
check_args "$@"

php "$ROOT/ingest.php" "$@"

if ! curl -s -o /dev/null --max-time 1 "http://localhost:$PORT/api/projects"; then
    php -S "localhost:$PORT" -t "$ROOT/public" "$ROOT/public/index.php" >/dev/null 2>&1 &
    SERVER_PID=$!
    trap 'kill $SERVER_PID 2>/dev/null' INT TERM EXIT
    sleep 0.5
else
    SERVER_PID=""
    trap 'exit 0' INT TERM
fi

open "http://localhost:$PORT"

echo "worklog running at http://localhost:$PORT — re-ingesting every 5 min, Ctrl-C to stop"
while true; do
    sleep 300
    php "$ROOT/ingest.php" "$@" >/dev/null 2>&1
done
