#!/bin/bash
# Presence sampler: logs keyboard/mouse idle seconds once a minute, so ingest can
# tell "away from the Mac" from "working outside the agent". Stays on this machine.
# The subcommands are in print_help; launchd runs "bin/presence sample".
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LOG="$ROOT/presence.log"
LABEL="com.ai-worklog.presence"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
DOMAIN="gui/$(id -u)"
USAGE="usage: bin/presence sample | install | uninstall | status"

print_help() {
    cat <<EOF
$USAGE

Records your keyboard and mouse idle time once a minute in presence.log, so
ingest can tell "away from the Mac" from "working outside the agent". The
samples stay on this Mac.

  sample       append "<epoch> <idle_seconds> <zone>" to presence.log (launchd runs this)
  install      load a LaunchAgent that samples every 60 s, also after login
  uninstall    unload and remove the LaunchAgent (presence.log is kept)
  status       show whether it is loaded and the newest samples
  -h, --help   print this help, then exit
EOF
}

usage_error() {
    echo "$1" >&2
    echo "$USAGE" >&2
    exit 2
}

for arg in "$@"; do
    case "$arg" in -h | --help) print_help; exit 0 ;; esac
done
if [ $# -gt 1 ]; then
    usage_error "unknown option: $2"
fi

case "${1:-}" in
sample)
    ns=$(/usr/sbin/ioreg -c IOHIDSystem | /usr/bin/awk '/HIDIdleTime/ {print $NF; exit}')
    case "$ns" in '' | *[!0-9]*) exit 1 ;; esac
    tz=$(/usr/bin/readlink /etc/localtime)
    tz=${tz#*zoneinfo/}
    echo "$(/bin/date +%s) $((ns / 1000000000))${tz:+ $tz}" >> "$LOG"
    ;;
install)
    mkdir -p "$(dirname "$PLIST")"
    cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>$LABEL</string>
    <key>ProgramArguments</key>
    <array><string>$ROOT/bin/presence</string><string>sample</string></array>
    <key>StartInterval</key><integer>60</integer>
    <key>RunAtLoad</key><true/>
</dict>
</plist>
EOF
    /bin/launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null
    /bin/launchctl bootstrap "$DOMAIN" "$PLIST" && echo "installed: sampling every 60 s into $LOG"
    ;;
uninstall)
    /bin/launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null
    rm -f "$PLIST"
    echo "uninstalled (presence.log kept)"
    ;;
status)
    if /bin/launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; then
        echo "loaded: $LABEL"
    else
        echo "not loaded — run bin/presence install"
    fi
    if [ -f "$LOG" ]; then
        echo "$(wc -l < "$LOG" | tr -d ' ') samples in $LOG, newest:"
        tail -3 "$LOG"
    else
        echo "no samples yet"
    fi
    ;;
'')
    usage_error "missing subcommand"
    ;;
*)
    usage_error "unknown option: $1"
    ;;
esac
